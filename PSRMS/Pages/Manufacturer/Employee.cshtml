@page
@model PSRMS.Pages.Manufactors.EmployeeModel
@{
    ViewData["Title"] = "Employee";
}

<div class="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a class="nav-link" asp-page="/Manufacturer/Dashboard">Dashboard</a>
        </li>

        <li class="breadcrumb-item active" aria-current="page">
            Employee
        </li>
    </ol>
</div>


<div class="container">

    <!-- Add Employee -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-dark">
            <h5 class="mb-0 text-white">Add Employee</h5>
        </div>

        <div class="card-body">

            <form method="post" id="EmployeeValidate">

                <div class="row">

                    <!-- Employee ID -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Employee ID
                        </label>

                        <input type="text" asp-for="employee.EmployeeId"
                               class="form-control"
                               placeholder="Enter Employee ID" />
                               <span class="text-danger"></span>
                    </div>


                    <!-- Full Name -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Full Name
                        </label>

                        <input type="text" asp-for="employee.FullName"
                               class="form-control"
                               placeholder="Enter Full Name" />
                               <span class="text-danger"></span>
                    </div>


                    <!-- Business Email -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Business Email
                        </label>

                        <input type="email" asp-for="employee.BusinessEmail"
                               class="form-control"
                               placeholder="Enter Business Email" />
                               <span class="text-danger"></span>
                    </div>


                    <!-- Contact Number -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Contact Number
                        </label>

                        <input type="tel"
                               class="form-control" asp-for="employee.ContactNumber"
                               placeholder="Enter Contact Number" />
                               <span class="text-danger"></span>
                    </div>


                    <!-- Department -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Department
                        </label>

                        <select class="form-select" asp-for="employee.Department">
                            <option value="">Select Department</option>
                            <option>Product Management</option>
                            <option>Quality</option>
                            <option>Recall Management</option>
                            <option>Customer Support</option>
                            <option>Sales</option>
                        </select>
                        <span class="text-danger"></span>
                    </div>


                    <!-- Role -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Role
                        </label>

                        <select class="form-select" asp-for="employee.Role">
                            <option value="">Select Role</option>
                            <option>Manufacturer Admin</option>
                            <option>Product Manager</option>
                            <option>Recall Manager</option>
                            <option>Quality Manager</option>
                            <option>Customer Support</option>
                            <option>Employee</option>
                        </select>
                        <span class="text-danger"></span>
                    </div>


                    <!-- Status -->
                    @* <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Status
                        </label>

                        <select class="form-select">
                            <option value="">Select Status</option>
                            <option>Active</option>
                            <option>Inactive</option>
                        </select>
                    </div> *@

                </div>


                <!-- Buttons -->
                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Add Employee
                    </button>

                    <button type="reset"
                            class="btn btn-secondary">
                        Clear
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- Employee List -->
    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">Employee List</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">

