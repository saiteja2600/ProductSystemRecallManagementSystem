                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        $(function () {

            $.validator.addMethod(
                "indianMobile",
                function (value, element) {
                    return this.optional(element) ||
                        /^(?:(?:\+91|91|0)[\s-]?)?[6-9]\d{9}$/.test(value);
                },
                "Enter a valid mobile number."
            );

            $("#EmployeeValidate").validate({

                rules: {

                    "employee.EmployeeId": {
                        required: true,
                        minlength: 3,
                        maxlength: 20
                    },

                    "employee.FullName": {
                        required: true,
                        minlength: 3
                    },

                    "employee.BusinessEmail": {
                        required: true,
                        email: true
                    },

                    "employee.ContactNumber": {
                        required: true,
                        indianMobile: true
                    },

                    "employee.Department": {
                        required: true
                    },

                    "employee.Role": {
                        required: true
                    }
                },

                messages: {

                    "employee.EmployeeId": {
                        required: "Enter Employee ID.",
                        minlength: "Employee ID must be at least 3 characters.",
                        maxlength: "Employee ID cannot exceed 20 characters."
                    },

                    "employee.FullName": {
                        required: "Enter Full Name.",
                        minlength: "Full Name must be at least 3 characters."
                    },

                    "employee.BusinessEmail": {
                        required: "Enter Business Email.",
                        email: "Enter a valid email address."
                    },

                    "employee.ContactNumber": {
                        required: "Enter Contact Number."
                    },

                    "employee.Department": {
                        required: "Please select a department."
                    },

                    "employee.Role": {
                        required: "Please select a role."
                    }
                },

                errorElement: "span",

                errorClass: "text-danger",

                highlight: function (element) {
                    $(element).addClass("is-invalid");
                },

                unhighlight: function (element) {
                    $(element).removeClass("is-invalid");
                },

                errorPlacement: function (error, element) {
                    error.insertAfter(element);
                }
                

            });
            $("#EmployeeValidate").on("reset", function () {
                const form = $(this);

                setTimeout(function () {
                    form.validate().resetForm();
                    form.find(".is-invalid").removeClass("is-invalid");
                }, 0);
            });

        });

    </script>
}