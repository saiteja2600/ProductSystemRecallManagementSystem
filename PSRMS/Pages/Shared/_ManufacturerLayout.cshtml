@using Microsoft.AspNetCore.Http
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - PSRMS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/manufacturer-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PSRMS.styles.css" asp-append-version="true" />
</head>

<body>

    <div class="d-flex" style="min-height: 100vh;">

        <!-- Desktop sidebar -->
        <aside class="portal-sidebar bg-dark border-end d-none d-md-flex flex-column">
            <div class="p-3 border-bottom">
                <a asp-page="/Manufacturer/Dashboard" class="d-flex align-items-center gap-2 text-decoration-none">
                    <div class="brand-badge">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path
                            d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" />
                        </svg>
                    </div>
                    <div class="brand-text">
                        <div class="brand-title text-white">PSRMS</div>
                        <div class="brand-subtitle text-white">Product Safety Recall Management</div>
                    </div>
                </a>
            </div>

            <nav class="nav flex-column p-2 flex-grow-1" aria-label="Manufacturer navigation">
                <a asp-page="/Manufacturer/Dashboard"
                   class="nav-link sidebar-link text-white @(currentPage == "/Manufacturer/Dashboard" ? "active" : "") d-flex align-items-center gap-2">

                    <i class="bi bi-speedometer2"></i> Dashboard

                </a>
                <a asp-page="/Manufacturer/Employee" class="nav-link sidebar-link text-white @(currentPage == "/Manufacturer/Employee" ? "active" : "") d-flex align-items-center gap-2">
                   <i class="bi bi-people"></i> Employee
                </a>
                <a asp-page="/Manufacturer/Products"
   class="nav-link  sidebar-link text-white @(currentPage == "/Manufacturer/Products" ? "active" : "") d-flex align-items-center gap-2">
    <i class="bi bi-box-seam"></i> Products
</a>
                <a asp-page="/Manufacturer/Complaints/Index"
                   class="nav-link sidebar-link text-white d-flex align-items-center gap-2">
                    <i class="bi bi-chat-left-text"></i> Complaints
                </a>
                <a asp-page="/Manufacturer/Recalls/Index" class="nav-link text-white sidebar-link d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle"></i> Recall Management
                </a>
                <a asp-page="/Manufacturer/Claims/Index" class="nav-link text-white sidebar-link d-flex align-items-center gap-2">
                    <i class="bi bi-life-preserver"></i> Customer Resolutions
                </a>
                <a asp-page="/Manufacturer/Reports/Index" class="nav-link text-white sidebar-link d-flex align-items-center gap-2">
                    <i class="bi bi-clipboard-data"></i> Reports
                </a>
            </nav>

            @* <div class="p-3 border-top">
                <div class="d-flex gap-2 p-2 bg-light rounded small">
                    <i class="bi bi-question-circle-fill text-primary fs-5"></i>
                    <div>
                        <strong class="d-block">Need assistance?</strong>
                        <span class="text-muted">Contact your system administrator.</span>
                    </div>
                </div>
            </div> *@
        </aside>

        <div class="d-flex flex-column flex-grow-1 min-w-0">

            <!-- Top navigation -->
            <header class="d-flex justify-content-between align-items-center bg-white border-bottom px-4 py-3">
                <div>
                    <p class="text-uppercase text-muted small mb-0 fw-semibold">Product Safety Operations</p>
                    <h1 class="h4 fw-bold mb-0">@ViewData["PageHeading"]</h1>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <a asp-page="/Manufacturer/Notifications/Index"
                       class="btn btn-light border rounded-circle position-relative d-flex align-items-center justify-content-center"
                       style="width:38px;height:38px;" aria-label="Notifications">
                        <i class="bi bi-bell"></i>
                        <span
                        class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                    </a>

                    <div class="d-flex align-items-center gap-2 pe-3 border-end">
                        <span
                            class="d-flex align-items-center justify-content-center bg-primary text-white rounded-circle fw-bold"
                            style="width:38px;height:38px;">
                            <i class="bi bi-person-fill"></i>
                        </span>
                        <div class="small lh-sm d-none d-lg-block">
                            <strong class="d-block">Manufacturer Account</strong>
                            <span class="text-muted">Authorized user</span>
                        </div>
                    </div>

                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                            <i class="bi bi-box-arrow-right"></i> Sign out
                        </button>
                    </form>
                </div>
            </header>

            @* <!-- Mobile navigation -->
            <nav class="d-flex d-md-none overflow-auto bg-white border-bottom px-2 py-2 gap-1"
                 aria-label="Mobile manufacturer navigation">
                <a asp-page="/Manufacturer/Dashboard" class="btn btn-sm btn-light text-nowrap"><i
                    class="bi bi-speedometer2"></i> Dashboard</a>
                    <a asp-page="/Manufacturer/Products/Index" class="btn btn-sm btn-light text-nowrap"><i
                        class="bi bi-box-seam"></i> Products</a>
                        <a asp-page="/Manufacturer/Complaints/Index" class="btn btn-sm btn-light text-nowrap"><i
                            class="bi bi-chat-left-text"></i> Complaints</a>
                            <a asp-page="/Manufacturer/Recalls/Index" class="btn btn-sm btn-light text-nowrap"><i
                                class="bi bi-exclamation-triangle"></i> Recalls</a>
                            </nav> *@

                            <!-- Page content -->
                            <main class="flex-grow-1 p-4">
                                @RenderBody()
                            </main>

                            <!-- Footer -->
                            <footer class="border-top bg-white py-3">
                                <div class="container-fluid d-flex justify-content-between align-items-center flex-wrap gap-2 px-4">
                                    <span class="text-muted small">&copy; @DateTime.Now.Year PSRMS &mdash; Product Safety Recall
                                        Management System</span>
                                        <a asp-page="/Privacy" class="text-muted small text-decoration-none">Privacy</a>
                                    </div>
                                </footer>
                            </div>
                        </div>

                        <script src="~/lib/jquery/dist/jquery.min.js"></script>
                        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                        <script src="~/js/site.js" asp-append-version="true"></script>
                        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
                        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

                        @await RenderSectionAsync("Scripts", required: false)

                    </body>

                </html>